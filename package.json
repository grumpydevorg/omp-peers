{
  "name": "omp-peers",
  "version": "2.0.0-preview.1",
  "description": "Claude-Code-style cross-session peer awareness for Oh My Pi (omp) and pi: every running instance sees every other, live, on the same machine — /peers to list, /rename to name, peer_send to talk.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "biome check src test",
    "format": "biome check --write src test",
    "test": "npm run build && npm run lint && node --test test/*.mjs",
    "smoke": "npm run build && node --test test/*.mjs"
  },
  "omp": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "keywords": [
    "oh-my-pi",
    "pi-coding-agent",
    "agents",
    "peers",
    "cross-session",
    "messaging",
    "multi-agent"
  ],
  "author": "Nikko Gonzales <nikkoxgonzales@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grumpydevorg/omp-peers.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.5.0",
    "fast-check": "4.10.2",
    "typescript": "^7.0.2"
  },
  "homepage": "https://github.com/grumpydevorg/omp-peers#readme",
  "bugs": {
    "url": "https://github.com/grumpydevorg/omp-peers/issues"
  },
  "contributors": [
    "Rick Morgans <rick.morgans@supersensory.com.au>",
    "hezirel (https://github.com/hezirel)"
  ]
}
